# Supabase project (Project Settings → API). Required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# YouTube Data API v3 key. Optional but recommended for a deployed site:
# without it, video descriptions, playlists and channel pictures are read
# from youtube.com's own pages, which YouTube sometimes blocks for servers.
# Server-only; never prefix it with NEXT_PUBLIC_.
YOUTUBE_API_KEY=
